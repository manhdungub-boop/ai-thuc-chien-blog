{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-thuc-chien-blog",
  "account_id": "92cf091bbac8b4879ec65feb30b4715b",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker.mjs",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-thuc-chien-community",
      "database_id": "fc2517cb-9543-4d7b-98f4-bcd5f3c013e7"
    }
  ]
}
