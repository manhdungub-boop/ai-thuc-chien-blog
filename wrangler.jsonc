{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-thuc-chien-blog",
  "account_id": "92cf091bbac8b4879ec65feb30b4715b",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "assets_navigation_has_no_effect"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "COMMUNITY_EMAIL_RELAY_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker.mjs",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-thuc-chien-community",
      "database_id": "fc2517cb-9543-4d7b-98f4-bcd5f3c013e7"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ai-thuc-chien-community-preview",
        "database_id": "51d814c8-a3fc-4481-a5f1-60bc67617f3c"
      }
    ]
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
