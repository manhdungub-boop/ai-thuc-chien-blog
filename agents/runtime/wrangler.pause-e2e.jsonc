{
  "name": "ai-thuc-chien-agent-runtime-pause-e2e",
  "main": "./tests/pause-e2e-worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "AGENT_INGRESS_RATE_LIMITER",
      "namespace_id": "2026112501",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_STATE_STORE",
        "class_name": "PauseE2EAgentStateStore"
      },
      {
        "name": "AGENT_DRAFT_STORE",
        "class_name": "AgentDraftStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pause-e2e-v1",
      "new_sqlite_classes": [
        "PauseE2EAgentStateStore",
        "AgentDraftStore"
      ]
    }
  ],
  "vars": {
    "AGENT_ENABLED": "false",
    "AGENT_PAUSED": "true",
    "AGENT_SCHEDULER_ENABLED": "false",
    "AGENT_RECOVERY_ALARM_ENABLED": "false",
    "AGENT_OIDC_ENABLED": "true",
    "AGENT_OIDC_RUN_ENABLED": "false",
    "AGENT_PAUSE_E2E_GATE_ENABLED": "true",
    "AGENT_REVIEWER_AUTH_ENABLED": "false",
    "AGENT_CONSOLE_ACCESS_PROTECTED": "true",
    "AGENT_RATE_LIMIT_REQUIRED": "true",
    "AGENT_OIDC_AUDIENCE": "ai-thuc-chien-agent-runtime-preview",
    "AGENT_OIDC_REPOSITORY": "manhdungub-boop/ai-thuc-chien-blog",
    "AGENT_OIDC_REPOSITORY_OWNER": "manhdungub-boop",
    "AGENT_OIDC_REPOSITORY_ID": "1423636651",
    "AGENT_OIDC_REPOSITORY_OWNER_ID": "342528485",
    "AGENT_OIDC_RUN_REF": "disabled",
    "AGENT_OIDC_RUN_WORKFLOW_REF": "disabled",
    "AGENT_OIDC_RUN_ACTOR_ID": "disabled",
    "AGENT_OIDC_PAUSE_REF": "disabled",
    "AGENT_OIDC_PAUSE_WORKFLOW_REF": "disabled",
    "AGENT_OIDC_PAUSE_ACTOR_ID": "disabled"
  }
}
